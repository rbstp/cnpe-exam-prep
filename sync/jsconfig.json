// Type-checks the sync Worker (make typecheck). No npm dependency: the slice of
// the Workers runtime it uses is declared in env.d.ts.
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["worker.js", "env.d.ts"]
}
