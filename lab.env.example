# ── CNPE lab configuration ───────────────────────────────────────────────
# Sourced by every script. Override anything here.

# Lab root, defaults to this checkout.
LAB_HOME="${LAB_HOME:-$REPO_ROOT}"
CLUSTER="${CLUSTER:-cnpe}"           # main practice cluster
MESH_CLUSTER="${MESH_CLUSTER:-mesh}" # second cluster for Istio/Linkerd/Flagger

# CNI on the main cluster: cilium (real NetworkPolicy enforcement) or kindnet
CNI="${CNI:-cilium}"

# Kubernetes node image for kind. Pin this; bump deliberately.
K8S_IMAGE="${K8S_IMAGE:-kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5}"

# Local git server (source of truth for GitOps)
GITEA_USER="${GITEA_USER:-lab}"
GITEA_PASS="${GITEA_PASS:-CHANGEME-local-lab-password}"
GITEA_HOST="${GITEA_HOST:-gitea.lab}"
# Argo CD's Gitea SCM generator lists repos by org, so this must be a real org.
GITEA_ORG="${GITEA_ORG:-services}"   # resolvable inside the cluster via CoreDNS
GITEA_PORT="${GITEA_PORT:-3001}"   # host-side port

# Local OCI registry, connected to kind
REGISTRY_NAME="${REGISTRY_NAME:-kind-registry}"
REGISTRY_PORT="${REGISTRY_PORT:-5001}"

BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"

# ── How credentials work here ────────────────────────────────────────────
# Copy this file to lab.env (gitignored) and set GITEA_PASS.
