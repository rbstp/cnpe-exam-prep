# ── CNPE lab configuration ───────────────────────────────────────────────
# Source'd by every script. Override anything here.

# Defaults to this checkout. lib.sh sets REPO_ROOT before sourcing this file, so
# a clone into any directory works. Hardcoding $HOME/cnpe-lab meant a stranger
# got Backstage scaffolded into a surprise directory outside their clone.
LAB_HOME="${LAB_HOME:-$REPO_ROOT}"
CLUSTER="${CLUSTER:-cnpe}"           # main practice cluster
MESH_CLUSTER="${MESH_CLUSTER:-mesh}" # second cluster for Istio/Linkerd/Flagger

# CNI on the main cluster: cilium (real NetworkPolicy enforcement) or kindnet
CNI="${CNI:-cilium}"

# Kubernetes node image for kind. Pin this; bump deliberately.
K8S_IMAGE="${K8S_IMAGE:-kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5}"

# Local git server (source of truth for GitOps)
GITEA_USER="${GITEA_USER:-lab}"
GITEA_PASS="${GITEA_PASS:-CHANGEME-local-lab-password}"
GITEA_HOST="${GITEA_HOST:-gitea.lab}"
# Argo CD's Gitea SCM provider generator lists repos via the ORGANISATION API,
# so scaffolded services must land in a real gitea org, not under a user.
GITEA_ORG="${GITEA_ORG:-services}"   # resolvable INSIDE the cluster via CoreDNS
GITEA_PORT="${GITEA_PORT:-3001}"   # host-side port; 3000 is taken by Backstage dev

# Local OCI registry (kind-connected, no Docker Hub rate limits on rebuilds)
REGISTRY_NAME="${REGISTRY_NAME:-kind-registry}"
REGISTRY_PORT="${REGISTRY_PORT:-5001}"

BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"

# ── How credentials work here ────────────────────────────────────────────
# Copy this file to lab.env and edit it. lab.env is gitignored.
#
#     cp lab.env.example lab.env
#
# GITEA_PASS is the only value you must set. It is the admin password for a
# throwaway Gitea container reachable only from this machine, so it is not a
# real secret, but it must not live in git either.
#
# Generated at runtime, never committed:
#   .gitea-token   API token created by 'make gitea' (chmod 600)
#   .gitea-info    connection summary
#   Argo CD admin  random per install, read it with: make urls
#
# Grafana is admin/admin, set by scripts/50-observability.sh. Not a secret.
