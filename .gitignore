# Runtime credentials: generated by 'make gitea', never commit
.gitea-token
.gitea-info

# Resolved local CLI versions and image digests, written by 'make tools/refresh'
.lab-versions.json

# Your local config (copy from lab.env.example)
lab.env

# Staged audit policy, mounted into the control-plane node at cluster creation
.audit/

# Backstage app scaffolded by 'make portal': ~1GB of node_modules, and its
# app-config.local.yaml contains generated credentials
portal/

# Local tooling
.claude/
*.log
curriculum/cnpe-console.html

# Bytecode for the curriculum's python tools, which only ever run as scripts
__pycache__/
*.pyc

# CI-only Playwright install for the browser check (npm --no-save)
node_modules/

# Staged copy of the Pages site ('make site')
_site/

# Wrangler local state and local secrets for the sync Worker. The ids in
# sync/wrangler.toml are public; GITHUB_CLIENT_SECRET and SESSION_SECRET are not,
# and 'wrangler dev' reads them from here.
sync/.dev.vars
sync/.dev.vars.*
.wrangler/
