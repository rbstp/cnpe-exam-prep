// The quest is written in TypeScript and compiled into curriculum/assets/, where
// the compiled scripts are committed like the rest of the console's assets:
//     make ts          rewrite assets/game.js, game-sim.js and game-data.js (and src/console's)
//     make ts-check    exit 1 if the committed output is stale (CI runs this)
// Each file is a plain script, not a module, so it compiles to one file with the
// same window.CNPE_* globals the console has always loaded; nothing else changes.
{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "removeComments": false,
    "newLine": "lf",
    "rootDir": ".",
    "outDir": "../../assets",
    "types": []
  },
  // outDir sits under assets/, which tsc would otherwise exclude by default,
  // and cnpe.d.ts with it
  "exclude": [],
  "include": ["*.ts", "../../assets/cnpe.d.ts"]
}
