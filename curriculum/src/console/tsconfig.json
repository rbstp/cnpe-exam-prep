// The console's DOM-free modules (the progress merge and the command-block
// colouring) are written in TypeScript and compiled into curriculum/assets/ by
// tools/build-ts.sh, where the compiled scripts are committed like the rest of
// the console's assets, so the site still needs no build step and file:// works.
// Each file is a plain script, not a module, so it compiles to one file with the
// same window.CNPE_* globals the console has always loaded; nothing else changes.
{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "removeComments": false,
    "newLine": "lf",
    "rootDir": ".",
    "outDir": "../../assets",
    "types": []
  },
  // outDir sits under assets/, which tsc would otherwise exclude by default,
  // and cnpe.d.ts with it
  "exclude": [],
  "include": ["*.ts", "../../assets/cnpe.d.ts"]
}
