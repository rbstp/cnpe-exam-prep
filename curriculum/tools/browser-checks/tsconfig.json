// Type-checks the Node-side browser checks (make typecheck).
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "commonjs",
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.js", "*.d.ts", "../../assets/cnpe.d.ts"]
}
