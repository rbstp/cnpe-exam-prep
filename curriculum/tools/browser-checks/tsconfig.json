// Type-checks the Node-side browser checks:
//   tsc -p curriculum/tools/browser-checks/tsconfig.json    (or: make typecheck)
// Needs typescript, @types/node and playwright resolvable from the repo root,
// installed the same way CI installs playwright for the browser job:
//   npm install --no-save --no-package-lock typescript @types/node playwright
// The dom lib is in because these files run code inside page.evaluate();
// assets/cnpe.d.ts supplies the console's window globals for those callbacks.
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "commonjs",
    "strict": false,
    // unlike the assets project this one runs with noImplicitAny: it is what
    // makes a typo'd harness or Page member an error instead of a silent any
    "noImplicitAny": true,
    "types": ["node"]
  },
  "include": ["*.js", "*.d.ts", "../../assets/cnpe.d.ts"]
}
