// Type-checks the console's plain-JS assets against assets/cnpe.d.ts:
//   tsc -p curriculum/jsconfig.json        (or: make typecheck)
// noEmit keeps this purely a check; the browser still loads the .js files
// as they are and the console stays build-free and dependency-free.
// strict stays off on purpose: the code tolerates junk stores and unchecked
// querySelector results by design, and shape errors are what we want caught.
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "strict": false,
    "types": []
  },
  "include": ["assets/*.js", "assets/*.d.ts"]
}
