// Type-checks the console's plain-JS assets against assets/cnpe.d.ts.
{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "strict": false,
    // jsconfig defaults this to true, which would leave cnpe.d.ts unchecked
    "skipLibCheck": false,
    "types": []
  },
  "include": ["assets/*.js", "assets/*.d.ts"],
  // these are compiled from TypeScript in src/ and checked there
  "exclude": ["assets/game.js", "assets/game-sim.js", "assets/game-data.js", "assets/game-art.js", "assets/merge.js", "assets/syntax.js"]
}
